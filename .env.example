# =========================
# Required (all environments)
# =========================
TMDB_API_KEY=your_tmdb_api_key

# =========================
# Local development (DuckDB)
# =========================
# No additional configuration required

# =========================
# GCP / BigQuery (optional)
# Required only if running against BigQuery
# =========================
GCP_PROJECT_ID=your-gcp-project-id
BQ_LOCATION=US
GCS_BUCKET_NAME=your-gcs-bucket-name

# Authentication:
# - Local dev: uses gcloud auth application-default login
# - Production: provide service account JSON via GCP_KEYFILE_JSON
#
# GCP_KEYFILE_JSON='{"type":"service_account",...}'
